{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build/build.mjs",
  "outputDirectory": "site-internet",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "has": [{ "type": "query", "key": "page_id", "value": "1381" }], "destination": "/simulateur/", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page_id", "value": "1438" }], "destination": "/blog/", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "page_id", "value": "1455" }], "destination": "/contact/", "permanent": true },
    { "source": "/estimation", "destination": "/simulateur/", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
