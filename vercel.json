{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build/build.mjs",
  "outputDirectory": "site-internet",
  "framework": null,
  "regions": [
    "cdg1"
  ],
  "functions": {
    "api/contact.js": {
      "maxDuration": 30
    }
  },
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "capibnb.vercel.app"
        }
      ],
      "destination": "https://conciergeriecapibnb.fr/$1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page_id",
          "value": "1381"
        }
      ],
      "destination": "/simulateur/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page_id",
          "value": "1438"
        }
      ],
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page_id",
          "value": "1455"
        }
      ],
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/estimation",
      "destination": "/simulateur/",
      "permanent": true
    },
    {
      "source": "/estimation/",
      "destination": "/simulateur/",
      "permanent": true
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-content/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed/:path*",
      "destination": "/blog/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
